generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique @db.VarChar(254)
  fullName              String         @db.VarChar(100)
  password              String?
  provider              Provider       @default(LOCAL)
  isOnline              Boolean        @default(false)
  lastSeen              DateTime       @default(now())
  isGuest               Boolean        @default(false)
  profile               Profile?
  followedBy            UserFollow[]   @relation("FollowedBy")
  following             UserFollow[]   @relation("Following")
  notificationsSent     Notification[] @relation("Actor")
  notificationsReceived Notification[] @relation("Notifier")
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
}

model Profile {
  id          String  @id @default(uuid())
  description String?
  imageUrl    String?
  user        User    @relation(references: [id], fields: [userId])
  userId      String  @unique
}

model UserFollow {
  followedById String
  followedBy   User   @relation("FollowedBy", references: [id], fields: [followedById])
  followingId  String
  following    User   @relation("Following", references: [id], fields: [followingId])

  @@id([followedById, followingId])
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
}

model Notification {
  id         String           @id @default(uuid())
  actorId    String
  notifierId String
  createdAt  DateTime         @default(now())
  commentId  String?
  type       NotificationType
  actor      User             @relation("Actor", references: [id], fields: [actorId])
  notifier   User             @relation("Notifier", references: [id], fields: [notifierId])
  comment    Comment?         @relation(references: [id], fields: [commentId], onDelete: Cascade)
}

model Post {
  id        String    @id @default(uuid())
  title     String    @db.VarChar(255)
  content   String
  imageUrl  String?
  imageId   String?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(references: [id], fields: [userId])
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id            String         @id @default(uuid())
  content       String
  postId        String
  parentId      String?
  userId        String
  createdAt     DateTime       @default(now())
  post          Post           @relation(references: [id], fields: [postId], onDelete: Cascade)
  parent        Comment?       @relation("ParentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("ParentReplies")
  user          User           @relation(references: [id], fields: [userId])
  likes         Like[]
  notifications Notification[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  user      User     @relation(references: [id], fields: [userId])
  post      Post?    @relation(references: [id], fields: [postId], onDelete: Cascade)
  comment   Comment? @relation(references: [id], fields: [commentId], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}
