generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  username String  @unique @db.VarChar(100)
  email    String  @unique @db.VarChar(254)
  fullName String  @db.VarChar(100)
  password String?
}
