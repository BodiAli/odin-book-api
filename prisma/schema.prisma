generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GOOGLE
  GITHUB
  LOCAL
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique @db.VarChar(254)
  fullName              String         @db.VarChar(100)
  password              String?
  provider              Provider       @default(LOCAL)
  isOnline              Boolean        @default(false)
  lastSeen              DateTime       @default(now())
  isGuest               Boolean        @default(false)
  profile               Profile?
  followedBy            UserFollow[]   @relation("FollowedBy")
  following             UserFollow[]   @relation("Following")
  notificationsSent     Notification[] @relation("Actor")
  notificationsReceived Notification[] @relation("Notifier")
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
}

model Profile {
  id                   String               @id @default(uuid())
  description          String?
  imageUrl             String?
  user                 User                 @relation(references: [id], fields: [userId])
  userId               String               @unique
  notificationEntities NotificationEntity[]
}

model UserFollow {
  followedById String
  followedBy   User   @relation("FollowedBy", references: [id], fields: [followedById])
  followingId  String
  following    User   @relation("Following", references: [id], fields: [followingId])

  @@id([followedById, followingId])
}

enum NotificationType {
  FOLLOW
  COMMENT
  REPLY
}

model Notification {
  id                   String             @id @default(uuid())
  actorId              String
  actor                User               @relation("Actor", references: [id], fields: [actorId])
  notifierId           String
  notifier             User               @relation("Notifier", references: [id], fields: [notifierId])
  createdAt            DateTime           @default(now())
  notificationEntityId String             @unique
  notificationEntity   NotificationEntity @relation(fields: [notificationEntityId], references: [id])
}

model NotificationEntity {
  id           String           @id @default(uuid())
  profileId    String?
  postId       String?
  commentId    String?
  type         NotificationType
  profile      Profile?         @relation(references: [id], fields: [profileId])
  post         Post?            @relation(references: [id], fields: [postId])
  comment      Comment?         @relation(references: [id], fields: [commentId])
  notification Notification?
}

model Post {
  id                   String               @id @default(uuid())
  title                String               @db.VarChar(255)
  content              String
  imageUrl             String?
  imageId              String?
  createdAt            DateTime             @default(now())
  userId               String
  user                 User                 @relation(references: [id], fields: [userId])
  comments             Comment[]
  likes                Like[]
  notificationEntities NotificationEntity[]
}

model Comment {
  id                   String               @id @default(uuid())
  content              String
  postId               String
  parentId             String?
  userId               String
  createdAt            DateTime             @default(now())
  post                 Post                 @relation(references: [id], fields: [postId])
  parent               Comment?             @relation("ParentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies              Comment[]            @relation("ParentReplies")
  user                 User                 @relation(references: [id], fields: [userId])
  likes                Like[]
  notificationEntities NotificationEntity[]
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  user      User     @relation(references: [id], fields: [userId])
  post      Post?    @relation(references: [id], fields: [postId], onDelete: Cascade)
  comment   Comment? @relation(references: [id], fields: [commentId], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}
