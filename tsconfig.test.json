{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "#test-utils/*": [
        "./tests/utils/*"
      ],
    }
  },
  "include": [
    "tests",
    "src/types/globals"
  ]
}